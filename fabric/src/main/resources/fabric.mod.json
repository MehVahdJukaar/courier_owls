{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "${mod_homepage}",
    "sources": "${mod_github}"
  },
  "license": "${mod_license}",
  "icon": "icon.png",
  "accessWidener": "courier_owls.accesswidener",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.mehvahdjukaar.courier_owls.platform.CourierOwlsFabric"
    ]
  },
  "mixins": [
    "${mod_id}-common.mixins.json"
  ],
  "depends": {
    "fabric-api": "*",
    "minecraft": "=${minecraft_version}",
    "moonlight": ">=${moonlight_min_version}"
  },
  "suggests": {
    "supplementaries": "*"
  }
}
